<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Permissions de la section « Sécurité » de la spécification.
         Absentes volontairement : INTERNET, localisation, stockage, accessibilité. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Apportées par la bibliothèque Nordic pour Android 11 et avant (maxSdkVersion 30) :
         sans effet avec minSdk 31, retirées pour que le manifeste fusionné reste celui de la
         spécification. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        tools:node="remove" />

    <application
        android:name=".KickZwiftApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="tiramisu"
        android:supportsRtl="true"
        android:theme="@style/Theme.KickZwift">

        <!-- Seul composant exporté : l'activité de lancement. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage des exports (FIT, journal) par le partage Android, sans permission de stockage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Porte les liaisons BLE et la sortie écran éteint. Non exporté. -->
        <service
            android:name=".service.RideService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Apporté par androidx.profileinstaller, exporté (protégé par DUMP) : ramené à
             exported=false, la spécification n'admettant aucun récepteur exporté. Les profils
             de démarrage restent installés par son initialiseur. La classe n'est présente qu'à
             l'exécution (dépendance transitive), d'où MissingClass ignoré ici seulement. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:replace="android:exported" />

        <!-- Apportés par Scanner Compat pour le scan par PendingIntent, que l'app n'utilise pas
             (scan par rappel, au premier plan). Le récepteur est exporté : retirés tous deux.
             Classes vues par :ble seulement, d'où MissingClass ignoré ici. -->
        <service
            android:name="no.nordicsemi.android.support.v18.scanner.ScannerService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="no.nordicsemi.android.support.v18.scanner.PendingIntentReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>
</manifest>
